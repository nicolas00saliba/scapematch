{
  "mcpServers": {
    "serena": {
      "command": "bash",
      "args": [
        "${workspaceFolder}/.cursor/bin/serena-mcp.sh",
        "${workspaceFolder}"
      ]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${env:CONTEXT7_API_KEY}"
      }
    }
  }
}
