---
import { BING_SITE_VERIFICATION, GOOGLE_SITE_VERIFICATION } from 'astro:env/server';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { semTrilha, trilha } from '../data/nav';
import { organizacao, website } from '../data/seo';
import { tokenBuscador } from '../../scripts/verificacao-buscadores.mjs';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publico?: boolean;
  convite?: boolean;
  hash?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/assets/og.png',
  imageAlt = 'EscapeMatch, plataforma para jogar escape room quando se está sozinho.',
  noindex = false,
  jsonLd,
  publico = false,
  convite = false,
  hash = false,
} = Astro.props;

const canonical = path === '/'
  ? 'https://escapematch.com.br/'
  : `https://escapematch.com.br${path}`;
const image = `https://escapematch.com.br${ogImage}`;
const mostrarTrilha = !semTrilha(path);
const itens = mostrarTrilha ? trilha(path) : [];

const blocos: Record<string, unknown>[] = [organizacao, website];
if (mostrarTrilha) {
  blocos.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: itens.map((item, indice) => ({
      '@type': 'ListItem',
      position: indice + 1,
      name: item.nome,
      item: item.href === '/'
        ? 'https://escapematch.com.br/'
        : `https://escapematch.com.br${item.href}`,
    })),
  });
}
if (jsonLd) {
  blocos.push(...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]));
}
const json = JSON.stringify(blocos).replace(/</g, '\\u003c');
const googleVerificacao = tokenBuscador(GOOGLE_SITE_VERIFICATION);
const bingVerificacao = tokenBuscador(BING_SITE_VERIFICATION);
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; worker-src 'none'; frame-src 'none'; manifest-src 'self'; form-action 'self'">
    <script is:inline src="/frame-guard.js"></script>
    <title>{title}</title>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex">}
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="EscapeMatch">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:alt" content={imageAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>
    <meta name="twitter:image:alt" content={imageAlt}>
    <meta name="theme-color" content="#0F4C4A">
    {googleVerificacao && <meta name="google-site-verification" content={googleVerificacao} />}
    {bingVerificacao && <meta name="msvalidate.01" content={bingVerificacao} />}
    <link rel="preload" href="/assets/fonts/inter-latin-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/bricolage-grotesque-latin-700.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64 96x96 128x128 192x192 256x256">
    <link rel="icon" href="/assets/favicon-48.png" type="image/png" sizes="48x48">
    <link rel="icon" href="/assets/favicon-96.png" type="image/png" sizes="96x96">
    <link rel="icon" href="/assets/favicon-192.png" type="image/png" sizes="192x192">
    <link rel="icon" href="/assets/favicon-512.png" type="image/png" sizes="512x512">
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    {blocos.length > 0 && <script type="application/ld+json" set:html={json} />}
  </head>
  <body>
    <Header />
    <main id="conteudo">
      {mostrarTrilha && (
        <div class="miolo">
          <Breadcrumb itens={itens} />
        </div>
      )}
      <slot />
    </main>
    <Footer itens={itens} />
    <script is:inline src="/scripts/menu.js"></script>
    {publico && <script is:inline src="/scripts/publico.js"></script>}
    {convite && <script is:inline src="/scripts/convite.js"></script>}
    {hash && <script is:inline src="/scripts/hash-rotas.js"></script>}
  </body>
</html>
