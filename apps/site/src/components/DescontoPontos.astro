---
interface Props {
  curto?: boolean;
}

const { curto = false } = Astro.props;
---

<aside class:list={['desconto-pontos', { 'desconto-curto': curto }]} aria-label="Jogue de graça com pontos">
  <p class="desconto-olho">Indique amigos, junte pontos e jogue de graça.</p>
  <p class="desconto-nota">1 ponto vale R$ 0,01.</p>
  <ul class="lista-simples">
    <li>Os pontos de indicação pagam a vaga inteira.</li>
    <li>Os pontos de boas-vindas e de cashback dão desconto.</li>
  </ul>
  {curto && (
    <p class="desconto-nota"><a href="/vantagens">Ver as vantagens</a></p>
  )}
</aside>
