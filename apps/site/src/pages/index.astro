---
import Base from '../layouts/Base.astro';
import PhoneShot from '../components/PhoneShot.astro';
import ProgramCard from '../components/ProgramCard.astro';
import { programaPorId } from '../data/programas';

const cartoes = ['boas-vindas', 'pontos-de-volta', 'indique-amigos'].map(programaPorId);

const organizacao = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'EscapeMatch',
  url: 'https://escapematch.com.br/',
  logo: 'https://escapematch.com.br/assets/logo-simbolo.svg',
};
---

<Base
  title="EscapeMatch: ninguém pra jogar? Agora tem."
  description="Está sozinho e quer jogar? O EscapeMatch te coloca num time com outros jogadores. Escape rooms, jogos de tabuleiro, laser tag e muito mais."
  path="/"
  ogImage="/assets/og/home.png"
  jsonLd={organizacao}
  publico
  hash
>
  <section class="hero">
    <div class="miolo hero-grade">
      <div>
        <h1>Ninguém pra jogar?<br>Agora tem.</h1>
        <p class="hero-badge">Escape rooms, jogos de tabuleiro, laser tag e muito mais!</p>
        <p class="hero-apoio">O EscapeMatch junta quem está sozinho em grupos de escape room. Você paga só a sua vaga.</p>
      </div>
      <PhoneShot cena="grupo" />
    </div>
  </section>

  <section class="publico" data-publico>
    <div class="miolo">
      <div class="publico-botoes" role="tablist" aria-label="Escolha o seu caminho">
        <button type="button" role="tab" id="tab-jogar" aria-controls="painel-jogar" aria-selected="true">Quero jogar</button>
        <button type="button" role="tab" id="tab-cliente" aria-controls="painel-cliente" aria-selected="false" tabindex="-1">Já jogo com a gente</button>
        <button type="button" role="tab" id="tab-casa" aria-controls="painel-casa" aria-selected="false" tabindex="-1">Tenho uma casa</button>
      </div>

      <div class="painel" role="tabpanel" id="painel-jogar" aria-labelledby="tab-jogar">
        <p class="painel-frase">Para quem ainda não jogou: entender, escolher e criar a conta.</p>
        <ul class="destinos">
          <li><a href="/como-funciona">Como funciona</a></li>
          <li><a href="/experiencias">O que jogar</a></li>
          <li><a href="/vantagens">Ganhe 100 pontos</a></li>
          <li><a href="/seguranca">Jogar com segurança</a></li>
        </ul>
        <div class="painel-acoes">
          <a class="btn" href="/app">Baixar o app</a>
        </div>
      </div>

      <div class="painel" role="tabpanel" id="painel-cliente" aria-labelledby="tab-cliente">
        <p class="painel-frase">Para quem já tem conta: entrar, indicar e tirar dúvidas.</p>
        <ul class="destinos">
          <li><a href="/vantagens/indique-amigos">Indique amigos</a></li>
          <li><a href="/vantagens/indique-uma-casa">Indique uma casa</a></li>
          <li><a href="/vantagens/niveis">Seus níveis e vantagens</a></li>
          <li><a href="/ajuda">Ajuda</a></li>
        </ul>
        <div class="painel-acoes">
          <a class="btn" href="https://app.escapematch.com.br/login" target="_blank" rel="noopener noreferrer">Entrar no app</a>
        </div>
      </div>

      <div class="painel" role="tabpanel" id="painel-casa" aria-labelledby="tab-casa">
        <div class="painel-acoes">
          <a class="btn btn-linha" href="/para-casas">Quero ser parceiro</a>
          <a class="btn btn-linha" href="https://parceiro.escapematch.com.br/" target="_blank" rel="noopener noreferrer">Já sou parceiro</a>
        </div>
        <ul class="destinos">
          <li><a href="/para-casas">Quero ser parceiro</a></li>
          <li><a href="/para-casas/cadastro">Cadastro</a></li>
          <li><a href="https://parceiro.escapematch.com.br/" target="_blank" rel="noopener noreferrer">Entrar no Parceiro</a></li>
          <li><a href="/para-casas/indique-uma-casa">Indique uma casa</a></li>
          <li><a href="/para-casas/indique-jogadores">Indique jogadores</a></li>
          <li><a href="/para-casas/horario-vazio">Horário vazio</a></li>
        </ul>
        <div class="painel-acoes">
          <a class="btn" href="/para-casas/cadastro">Seja parceiro</a>
          <a class="btn btn-linha" href="https://parceiro.escapematch.com.br/" target="_blank" rel="noopener noreferrer">Entrar no Parceiro</a>
        </div>
      </div>
    </div>
  </section>

  <section class="faixa">
    <div class="miolo">
      <a href="/cidades/curitiba">
        <img src="/assets/logo-simbolo.svg" alt="" width="18" height="24">
        Começando por Curitiba
      </a>
    </div>
  </section>

  <section class="secao">
    <div class="miolo">
      <div class="secao-topo">
        <h2>Como o time se forma</h2>
        <a href="/como-funciona">Como funciona</a>
      </div>
      <div class="passos-tela">
        <article>
          <h3>Você chega sozinho e escolhe a sala e o horário</h3>
          <PhoneShot cena="escolhe" />
        </article>
        <article>
          <h3>O app te coloca num grupo e você paga a sua vaga</h3>
          <PhoneShot cena="grupo" />
        </article>
        <article>
          <h3>O grupo bate o mínimo e o jogo está confirmado</h3>
          <PhoneShot cena="confirmado" />
        </article>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="miolo">
      <div class="secao-topo">
        <h2>Pontos para a próxima sala</h2>
        <a href="/vantagens">Vantagens</a>
      </div>
      <div class="grade-3">
        {cartoes.map((programa) => <ProgramCard programa={programa} />)}
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="miolo">
      <div class="secao-topo">
        <h2>O que dá para jogar</h2>
        <a href="/experiencias">Experiências</a>
      </div>
      <div class="modalidades">
        <a class="modalidade" href="/experiencias/escape-room">
          <div>
            <h3>Escape room</h3>
            <p>A modalidade disponível. Entre num grupo e pague só a sua vaga.</p>
          </div>
          <span class="etiqueta">Disponível</span>
        </a>
        <article class="modalidade modalidade-espera">
          <div>
            <h3>Jogos de tabuleiro</h3>
            <p>Em breve.</p>
          </div>
          <span class="etiqueta">Em breve</span>
        </article>
        <article class="modalidade modalidade-espera">
          <div>
            <h3>Laser tag</h3>
            <p>Em breve.</p>
          </div>
          <span class="etiqueta">Em breve</span>
        </article>
        <article class="modalidade modalidade-espera">
          <div>
            <h3>Outras modalidades</h3>
            <p>Em breve.</p>
          </div>
          <span class="etiqueta">Em breve</span>
        </article>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="miolo seguranca-home">
      <div>
        <h2>Pagamento e convivência</h2>
        <p class="hero-apoio">Pix e cartão passam pela Asaas. O app não guarda o número do cartão.</p>
      </div>
      <div>
        <p>Respeito com todos. Nada de discriminação ou assédio. Chegue no horário e siga as regras da casa.</p>
        <p><a href="/seguranca">Jogar com segurança</a></p>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="miolo">
      <div class="secao-topo">
        <h2>Perguntas frequentes</h2>
        <a href="/ajuda">Central de ajuda</a>
      </div>
      <div class="faq leitura">
        <details>
          <summary>Eu pago a reserva inteira?</summary>
          <p>Não. O preço é por pessoa. Você paga só a sua vaga.</p>
        </details>
        <details>
          <summary>Quando a cobrança acontece?</summary>
          <p>Quando o grupo bate o mínimo e o jogo confirma. Quem entra depois paga a própria vaga na hora, até lotar.</p>
        </details>
        <details>
          <summary>E se o grupo não confirmar?</summary>
          <p>Nada é cobrado. O Pix é estornado e o cartão não é capturado.</p>
        </details>
        <details>
          <summary>Dá para jogar sem conhecer ninguém?</summary>
          <p>Dá. O app te coloca num grupo. As regras de convivência estão em Segurança.</p>
        </details>
        <details>
          <summary>Só tem escape room?</summary>
          <p>Escape room é o que está disponível. Jogos de tabuleiro, laser tag e outras modalidades estão em breve.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="chamada">
    <div class="miolo">
      <h2>Sua próxima sala começa com um grupo.</h2>
      <a class="btn" href="/app">Baixar o app</a>
    </div>
  </section>
</Base>
