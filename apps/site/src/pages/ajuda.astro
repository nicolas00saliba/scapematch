---
import Base from '../layouts/Base.astro';
import PageTop from '../components/PageTop.astro';
import DescontoPontos from '../components/DescontoPontos.astro';
import { perguntasVistas, temas } from '../data/ajuda';
import { faqPage } from '../data/seo';

const faq = faqPage(perguntasVistas.map(({ pergunta }) => pergunta));
---

<Base
  title="Ajuda para jogar sem grupo | EscapeMatch"
  description="Como achar um grupo de escape room, pagar a vaga e usar pontos como desconto na sala."
  path="/ajuda"
  jsonLd={faq}
>
  <PageTop titulo="Central de ajuda" frase="Grupo, pagamento, cancelamento, conta, pontos e casas." />
  <div class="miolo pagina">
    <p>Está sozinho e quer jogar escape room? O <a href="/guia/escape-room-sozinho">guia de escape room sozinho</a> responde direto.</p>
    <DescontoPontos />
    <h2 class="secao-interna">Temas</h2>
    <div class="modalidades">
      {temas.map((tema) => (
        <a class="modalidade" href={`/ajuda/${tema.slug}`}>
          <div>
            <h3>{tema.nome}</h3>
            <p>{tema.frase}</p>
          </div>
        </a>
      ))}
    </div>
    <section>
      <h2>Perguntas mais vistas</h2>
      <div class="faq">
        {perguntasVistas.map(({ tema, pergunta }) => (
          <details>
            <summary>{pergunta.pergunta}</summary>
            <p>{pergunta.resposta}</p>
            <p><a href={`/ajuda/${tema}`}>Ver o tema</a></p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>
