---
import Base from '../../layouts/Base.astro';
import PageTop from '../../components/PageTop.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import DescontoPontos from '../../components/DescontoPontos.astro';
import { programaPorId } from '../../data/programas';

const programa = programaPorId('niveis');
---

<Base title={programa.seoTitulo} description={programa.seoDescricao} path={programa.rota} ogImage={programa.og}>
  <PageTop titulo="Níveis de indicação" frase={programa.apoio} />
  <div class="miolo pagina">
    <DescontoPontos />
    <div class="niveis">
      <article class="nivel">
        <h2>1%</h2>
        <p>Desde o primeiro indicado ativo. Cada reserva dele rende 1% em pontos.</p>
      </article>
      <article class="nivel">
        <h2>2,5%</h2>
        <p>A partir de 5 indicados ativos. A taxa passa a ser 2,5%, no lugar da anterior.</p>
      </article>
      <article class="nivel">
        <h2>5%</h2>
        <p>A partir de 8 indicados ativos. A taxa passa a ser 5%.</p>
      </article>
    </div>
    <section class="leitura">
      <h2>Como subir</h2>
      <p>Ativo é quem tem atribuição ativa e pagou uma reserva nos últimos 90 dias. Os níveis valem só quando um jogador indica outro jogador.</p>
    </section>
    <ProgramCard programa={programa} />
  </div>
  <CtaBlock titulo={programa.cta.rotulo} acoes={[programa.cta]} />
</Base>
