---
import Base from '../../layouts/Base.astro';
import PageTop from '../../components/PageTop.astro';
import DescontoPontos from '../../components/DescontoPontos.astro';
import {
  programas,
  regrasCasa,
  regrasFraude,
  regrasJogador,
  regrasVagaGratis,
  regrasVersao,
  sorteioPontos,
} from '../../data/programas';
---

<Base
  title="Regulamento para jogar de graça | EscapeMatch"
  description="100 pontos valem R$ 1. Dá para pagar em dinheiro, em pontos ou nos dois."
  path="/vantagens/regulamento"
>
  <PageTop
    titulo="Regulamento dos pontos"
    frase="A versão única das regras de pontos e de crédito, com a data."
  />
  <article class="miolo pagina leitura">
    <p class="versao">Versão {regrasVersao}.</p>
    <DescontoPontos />
    <h2>Regras de uso</h2>
    <ol class="lista-simples">
      {regrasVagaGratis.map((regra) => <li>{regra}</li>)}
    </ol>

    <h2>Jogador</h2>
    {programas.filter((item) => item.publico === 'jogador').map((item) => (
      <section>
        <h3>{item.titulo}</h3>
        <p>{item.beneficio}. {item.apoio}</p>
        <p>{item.regras}</p>
      </section>
    ))}
    <p>{sorteioPontos}</p>
    <ul class="lista-simples">
      {regrasJogador.map((regra) => <li>{regra}</li>)}
    </ul>

    <h2>Casa</h2>
    {programas.filter((item) => item.publico === 'casa').map((item) => (
      <section>
        <h3>{item.titulo}</h3>
        <p>{item.beneficio}. {item.apoio}</p>
        <p>{item.regras}</p>
      </section>
    ))}
    <ul class="lista-simples">
      {regrasCasa.map((regra) => <li>{regra}</li>)}
    </ul>

    <h2>Segurança contra fraude</h2>
    {regrasFraude.map((item) => (
      <section>
        <h3>{item.titulo}</h3>
        <p>{item.texto}</p>
      </section>
    ))}

    <h2>Histórico de versões</h2>
    <p>{regrasVersao}: 100 pontos valem R$ 1. Indicação de pessoas começa em 1%, vai a 2,5% com 5 indicados ativos e a 5% com 8. Casa e jogador que indica casa ficam em 5%. Horário vazio não dobra. Dá para pagar em dinheiro, em pontos ou nos dois, sem mínimo e sem teto de 30%. A primeira sessão é 20% com código de indicação e 10% sem código.</p>
  </article>
</Base>
