---
import Base from '../../layouts/Base.astro';
import PageTop from '../../components/PageTop.astro';
import DescontoPontos from '../../components/DescontoPontos.astro';
import {
  programas,
  regrasCasa,
  regrasFraude,
  regrasJogador,
  regrasVagaGratis,
  regrasVersao,
  sorteioPontos,
} from '../../data/programas';
---

<Base
  title="Regulamento para jogar de graça | EscapeMatch"
  description="1 ponto vale R$ 0,01. Cashback e indicação pagam a vaga inteira. Uso a partir de 1.000 pontos."
  path="/vantagens/regulamento"
>
  <PageTop
    titulo="Regulamento dos pontos"
    frase="A versão única das regras de pontos e de crédito, com a data."
  />
  <article class="miolo pagina leitura">
    <p class="versao">Versão {regrasVersao}.</p>
    <DescontoPontos />
    <h2>Regras de uso</h2>
    <ol class="lista-simples">
      {regrasVagaGratis.map((regra) => <li>{regra}</li>)}
    </ol>

    <h2>Jogador</h2>
    {programas.filter((item) => item.publico === 'jogador').map((item) => (
      <section>
        <h3>{item.titulo}</h3>
        <p>{item.beneficio}. {item.apoio}</p>
        <p>{item.regras}</p>
      </section>
    ))}
    <p>{sorteioPontos}</p>
    <ul class="lista-simples">
      {regrasJogador.map((regra) => <li>{regra}</li>)}
    </ul>

    <h2>Casa</h2>
    {programas.filter((item) => item.publico === 'casa').map((item) => (
      <section>
        <h3>{item.titulo}</h3>
        <p>{item.beneficio}. {item.apoio}</p>
        <p>{item.regras}</p>
      </section>
    ))}
    <ul class="lista-simples">
      {regrasCasa.map((regra) => <li>{regra}</li>)}
    </ul>

    <h2>Segurança contra fraude</h2>
    {regrasFraude.map((item) => (
      <section>
        <h3>{item.titulo}</h3>
        <p>{item.texto}</p>
      </section>
    ))}

    <h2>Histórico de versões</h2>
    <p>{regrasVersao}: cashback e indicação se somam e pagam a vaga inteira. Boas-vindas e passaporte dão desconto, até o teto. O uso pede 1.000 pontos e devolve os pontos se a reserva for cancelada. O passaporte dá um carimbo por sala quando a casa confirma o comparecimento da reserva paga, e pontos bônus nos marcos. Avaliar a sala é um toque por item. A casa pode oferecer um mimo opcional, por conta dela.</p>
  </article>
</Base>
