---
import Base from '../layouts/Base.astro';
import PageTop from '../components/PageTop.astro';
import ProgramCard from '../components/ProgramCard.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { programasJogador, regrasJogador } from '../data/programas';
---

<Base
  title="Vantagens e pontos | EscapeMatch"
  description="Ganhe pontos ao criar a conta, em toda reserva e indicando amigos. Use os pontos na próxima sala."
  path="/vantagens"
  ogImage="/assets/og/vantagens.png"
>
  <PageTop
    titulo="Vantagens e pontos"
    frase="Tudo em pontos. 1 ponto vale R$ 0,01 e serve para pagar salas."
  />
  <div class="miolo pagina">
    <div class="grade-3">
      {programasJogador.map((programa) => <ProgramCard programa={programa} />)}
    </div>
    <section class="regras-comuns leitura">
      <h2>Como usar os pontos</h2>
      <ul class="lista-simples">
        {regrasJogador.map((regra) => <li>{regra}</li>)}
      </ul>
      <p><a href="/vantagens/regulamento">Regulamento dos pontos</a></p>
    </section>
  </div>
  <CtaBlock
    titulo="Criar conta ou pegar o código"
    acoes={[
      { rotulo: 'Criar conta e ganhar 100 pontos', href: 'https://app.escapematch.com.br/cadastro', externo: true },
      { rotulo: 'Pegar meu código no app', href: 'https://app.escapematch.com.br/login', externo: true },
    ]}
  />
</Base>
