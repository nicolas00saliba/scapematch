---
import Base from '../layouts/Base.astro';
import PageTop from '../components/PageTop.astro';
import ProgramCard from '../components/ProgramCard.astro';
import CtaBlock from '../components/CtaBlock.astro';
import DescontoPontos from '../components/DescontoPontos.astro';
import { programasJogador, regrasVagaGratis } from '../data/programas';
---

<Base
  title="Jogue de graça indicando amigos | EscapeMatch"
  description="Indique amigos, junte pontos e jogue de graça. 1 ponto vale R$ 0,01. A indicação paga a vaga inteira."
  path="/vantagens"
  ogImage="/assets/og/vantagens.png"
>
  <PageTop
    titulo="Indique amigos, junte pontos e jogue de graça."
    frase="1 ponto vale R$ 0,01. A indicação paga a vaga inteira. Boas-vindas e cashback dão desconto."
  />
  <div class="miolo pagina">
    <DescontoPontos />
    <h2 class="secao-interna">Como ganhar</h2>
    <div class="grade-3">
      {programasJogador.map((programa) => <ProgramCard programa={programa} />)}
    </div>
    <section class="regras-comuns leitura">
      <h2>Como usar os pontos</h2>
      <ul class="lista-simples">
        {regrasVagaGratis.map((regra) => <li>{regra}</li>)}
      </ul>
      <p><a href="/vantagens/regulamento">Regulamento dos pontos</a></p>
    </section>
  </div>
  <CtaBlock
    titulo="Criar conta ou pegar o código"
    acoes={[
      { rotulo: 'Criar conta e ganhar 100 pontos', href: 'https://app.escapematch.com.br/cadastro', externo: true },
      { rotulo: 'Pegar meu código no app', href: 'https://app.escapematch.com.br/login', externo: true },
    ]}
  />
</Base>
