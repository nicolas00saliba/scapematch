---
import Base from '../../layouts/Base.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { definicao, faqPage } from '../../data/seo';
import { oQueE } from '../../data/perguntas-marca';

const respostas = [
  {
    pergunta: 'Dá para jogar escape room para 2 pessoas?',
    resposta:
      'Dá para ir em dupla. O jogo confirma quando o grupo bate o mínimo da sala. Se duas pessoas ainda não fecham esse mínimo, o EscapeMatch completa as vagas que faltam. Cada um paga só a própria vaga. Se o mínimo não bater, nada é cobrado.',
  },
  {
    pergunta: 'A dupla paga a sala inteira?',
    resposta:
      'Não. O preço é por pessoa e é o da sala, mostrado no app. Não existe um ingresso único do EscapeMatch. Cada pessoa paga a própria vaga.',
  },
  {
    pergunta: 'Já somos duas pessoas. Dá para usar o app?',
    resposta:
      'Dá. Quem já tem uma dupla escolhe a sala e o horário e completa as vagas que faltam. Cada pessoa continua pagando a própria vaga. O jogo confirma no mínimo.',
  },
  {
    pergunta: 'A dupla precisa conhecer o resto do grupo?',
    resposta:
      'Não. Quem entra para completar a sala pode ser alguém que você não conhecia. Vocês se encontram na casa, no horário marcado, e a casa conduz a sessão.',
  },
  oQueE,
];
---

<Base
  title="Escape room para 2 pessoas | EscapeMatch"
  description="Escape room para duas pessoas. Se a dupla não fechar o mínimo, o app completa as vagas. Cada um paga a sua."
  path="/guia/escape-room-para-2-pessoas"
  ogImage="/assets/og/home.png"
  jsonLd={faqPage(respostas)}
>
  <header class="miolo pagina-topo">
    <h1>{respostas[0].pergunta}</h1>
    <p class="definicao-marca">{definicao}</p>
    <p class="resposta-direta">{respostas[0].resposta}</p>
  </header>
  <article class="miolo pagina leitura">
    <section>
      <h2>{respostas[1].pergunta}</h2>
      <p>{respostas[1].resposta}</p>
      <p>
        A cobrança da vaga acontece quando o grupo confirma.
        Veja <a href="/como-funciona/pagamento">Pagamento e regras</a>.
      </p>
    </section>
    <section>
      <h2>{respostas[2].pergunta}</h2>
      <p>{respostas[2].resposta}</p>
      <p>
        Chegar sem nenhuma companhia é outro recorte: <a href="/guia/escape-room-sozinho">escape room sozinho</a>.
        O passo a passo do grupo está em <a href="/como-funciona">Como funciona</a>.
      </p>
    </section>
    <section>
      <h2>{respostas[3].pergunta}</h2>
      <p>{respostas[3].resposta}</p>
      <p>
        Como essa sessão funciona está em <a href="/guia/escape-room-com-desconhecidos">escape room com desconhecidos</a>.
        O combinado está em <a href="/seguranca">Segurança</a>.
      </p>
    </section>
    <section>
      <h2>Dupla em Curitiba</h2>
      <p>
        O lançamento é em Curitiba, e a modalidade disponível é escape room.
        Salas, horários e o preço por pessoa estão no app. O site não lista casas parceiras, endereço nem preço.
      </p>
      <p>
        O grupo na cidade está em <a href="/guia/escape-room-em-grupo-curitiba">escape room em grupo em Curitiba</a>.
        A página da cidade é <a href="/escape-room-curitiba">Escape room em Curitiba</a>.
      </p>
    </section>
    <section>
      <h2>{oQueE.pergunta}</h2>
      <p>{oQueE.resposta}</p>
      <p>
        Outras formas de achar gente estão em <a href="/guia/como-achar-grupo-escape-room">onde achar grupo</a>.
        A lista dos recortes está em <a href="/guia">guias</a>.
      </p>
    </section>
  </article>
  <CtaBlock titulo="Entrar em dupla num grupo" acoes={[{ rotulo: 'Entrar num grupo', href: '/app' }]} />
</Base>
